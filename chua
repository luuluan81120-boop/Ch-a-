let curSutra=0,voiceOn=false,readTimer=null,readIdx=-1,reading=false;
function renderTabs(){
  $("#sutraTabs").innerHTML="";
  SUTRAS.forEach((s,i)=>{
    const b=document.createElement("button");b.textContent=s.name;
    b.className=i===curSutra?"active":"";
    b.onclick=()=>{stopRead();curSutra=i;renderSutra()};
    $("#sutraTabs").appendChild(b);
  });
}
function renderSutra(){
  renderTabs();
  const s=SUTRAS[curSutra];
  $("#sTitle").textContent=s.name;$("#sIntro").textContent=s.intro;
  const body=$("#sBody");body.innerHTML="";
  s.verses.forEach((v,i)=>{
    const d=document.createElement("div");d.className="verse";d.dataset.i=i;
    d.innerHTML='<div class="t"></div><div class="g"></div>';
    d.querySelector(".t").textContent=v.t;
    d.querySelector(".g").textContent="💡 "+v.g;
    d.onclick=()=>d.classList.toggle("open");
    body.appendChild(d);
  });
}
function speak(text,cb){
  if(!voiceOn||!("speechSynthesis" in window)){cb&&setTimeout(cb,Math.max(3500,text.length*85));return}
  try{
    speechSynthesis.cancel();
    const u=new SpeechSynthesisUtterance(text);u.lang="vi-VN";u.rate=.85;
    u.onend=()=>cb&&cb();u.onerror=()=>cb&&cb();
    speechSynthesis.speak(u);
  }catch(e){cb&&setTimeout(cb,3500)}
}
function stopRead(){
  reading=false;clearTimeout(readTimer);
  try{window.speechSynthesis&&speechSynthesis.cancel()}catch(e){}
  $$(".verse").forEach(v=>v.classList.remove("reading"));
  const b=$("#btnRead");if(b)b.textContent="▶ Tự động đọc";
}
function readNext(){
  if(!reading)return;
  readIdx++;
  const s=SUTRAS[curSutra];
  if(readIdx>=s.verses.length){stopRead();bell();return}
  $$(".verse").forEach(v=>v.classList.remove("reading"));
  const el=$$(".verse")[readIdx];
  el.classList.add("reading","open");
  el.scrollIntoView({behavior:"smooth",block:"center"});
  woodBlock();
  speak(s.verses[readIdx].t,()=>{readTimer=setTimeout(readNext,700)});
}
$("#btnRead").onclick=()=>{
  ac();
  if(reading){stopRead();return}
  reading=true;readIdx=-1;$("#btnRead").textContent="⏸ Dừng";readNext();
};
$("#btnVoice").onclick=()=>{
  voiceOn=!voiceOn;
  $("#btnVoice").textContent="🔊 Giọng đọc: "+(voiceOn?"Bật":"Tắt");
  if(!voiceOn){try{speechSynthesis.cancel()}catch(e){}}
};
$("#btnOpenAll").onclick=()=>{
  const vs=$$(".verse");const allOpen=vs.every(v=>v.classList.contains("open"));
  vs.forEach(v=>v.classList.toggle("open",!allOpen));
  $("#btnOpenAll").textContent=allOpen?"📖 Mở tất cả lời giảng":"📕 Đóng tất cả lời giảng";
};
renderSutra();

/* ---------- Niệm Phật / gõ mõ ---------- */
const CHANTS=["Nam mô A Di Đà Phật","Nam mô Quán Thế Âm Bồ Tát","Nam mô Bổn Sư Thích Ca Mâu Ni Phật","Nam mô Địa Tạng Vương Bồ Tát","Nam mô Dược Sư Lưu Ly Quang Vương Phật"];
CHANTS.forEach((c,i)=>{const o=document.createElement("option");o.value=i;o.textContent=c;$("#chantSel").appendChild(o)});
let moCount=store.get("chua_moCount",0),autoTimer=null;
const goalReached=()=>{const g=+$("#goalSel").value;return g>0&&moCount>0&&moCount%g===0};
function renderMo(){$("#moCount").textContent=moCount}
renderMo();
function hitMo(ev){
  ac();woodBlock();vib(15);
  moCount++;stats.mo++;
  if(moCount%4===0)stats.name++;
  store.set("chua_moCount",moCount);saveStats();renderMo();
  const btn=$("#moBtn");btn.classList.add("hit");setTimeout(()=>btn.classList.remove("hit"),80);
  const txt=CHANTS[+$("#chantSel").value].split(" ");
  const w=txt[(moCount-1)%txt.length]||"";
  $("#chantText").textContent=CHANTS[+$("#chantSel").value];
  const r=btn.getBoundingClientRect();
  const p=document.createElement("div");p.className="pop";p.textContent="🙏 +1";
  p.style.left=(r.left+r.width/2+(Math.random()*60-30))+"px";p.style.top=(r.top+10)+"px";
  document.body.appendChild(p);setTimeout(()=>p.remove(),1000);
  if(goalReached()){bell();$("#chantText").textContent="🎉 Tròn "+moCount+" biến — công đức viên mãn!"}
}
$("#moBtn").addEventListener("pointerdown",e=>{e.preventDefault();hitMo()});
$("#moBtn").addEventListener("keydown",e=>{if(e.key===" "||e.key==="Enter"){e.preventDefault();hitMo()}});
function stopAuto(){clearInterval(autoTimer);autoTimer=null;const b=$("#btnAuto");if(b)b.textContent="⏵ Tự động gõ"}
$("#btnAuto").onclick=()=>{
  if(autoTimer){stopAuto();return}
  ac();$("#btnAuto").textContent="⏸ Dừng";
  autoTimer=setInterval(hitMo,900);
};
$("#btnReset").onclick=()=>{moCount=0;store.set("chua_moCount",0);renderMo();$("#chantText").textContent="Chạm vào mõ để niệm"};
document.addEventListener("keydown",e=>{
  if($("#s-mo").classList.contains("active")&&e.code==="Space"&&document.activeElement.tagName!=="SELECT"&&document.activeElement.id!=="moBtn"){e.preventDefault();hitMo()}
});

/* ---------- Sổ cầu nguyện ---------- */
let prayers=store.get("chua_prayers",[]);
function esc(s){return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function renderPray(){
  const box=$("#prayList");
  if(!prayers.length){box.innerHTML='<p style="text-align:center;color:var(--muted);font-size:14px">Chưa có lời nguyện nào.</p>';return}
  box.innerHTML=prayers.map(p=>'<div class="pray-item"><b>'+esc(p.type)+'</b><br>'+esc(p.text)+'<small>'+esc(p.name||"Phật tử")+' · '+esc(p.date)+'</small></div>').join("");
}
$("#btnPray").onclick=()=>{
  const text=$("#pText").value.trim();
  if(!text){$("#pText").focus();return}
  prayers.unshift({type:$("#pType").value,text,name:$("#pName").value.trim(),date:new Date().toLocaleString("vi-VN")});
  prayers=prayers.slice(0,50);
  store.set("chua_prayers",prayers);
  $("#pText").value="";renderPray();bell();vib(40);
};
$("#btnClearPray").onclick=()=>{if(confirm("Xóa toàn bộ lời nguyện đã lưu?")){prayers=[];store.set("chua_prayers",prayers);renderPray()}};
renderPray();
})();
